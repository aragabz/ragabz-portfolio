# ========================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ========================================
# 1. CONTACT FORM (Formspree)
# ========================================
# Get your ID from: https://formspree.io/forms
# Example: xwkavvwr
PUBLIC_FORMSPREE_ID=YOUR_FORMSPREE_ID

# ========================================
# 2. NEWSLETTER (ConvertKit)
# ========================================
# Get your Form ID from: https://app.convertkit.com/forms
# Example: 1234567
PUBLIC_CONVERTKIT_FORM_ID=YOUR_CONVERTKIT_FORM_ID

# Optional: API Key for advanced features
PUBLIC_CONVERTKIT_API_KEY=YOUR_CONVERTKIT_API_KEY

# ========================================
# 3. COMMENTS (Giscus - GitHub Discussions)
# ========================================
# Get your values from: https://giscus.app/
# Example: yourusername/your-repo
PUBLIC_GISCUS_REPO=YOUR_GITHUB_USERNAME/YOUR_REPO
PUBLIC_GISCUS_REPO_ID=YOUR_REPO_ID
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=YOUR_CATEGORY_ID

# ========================================
# 4. RECAPTCHA (Optional - Spam Protection)
# ========================================
# Get keys from: https://www.google.com/recaptcha/admin
# Use reCAPTCHA v3 for invisible protection
PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY

# ========================================
# 5. ANALYTICS (Optional)
# ========================================
# Vercel Analytics (auto-detected on Vercel)
PUBLIC_VERCEL_ANALYTICS_ID=

# Google Analytics
PUBLIC_GA_ID=

# ========================================
# 6. ERROR TRACKING (Optional)
# ========================================
# Sentry DSN from: https://sentry.io/
SENTRY_DSN=

# ========================================
# 7. SITE CONFIGURATION
# ========================================
PUBLIC_SITE_URL=https://yourname.dev
PUBLIC_SITE_NAME=Your Name - Portfolio

# ========================================
# NOTES:
# ========================================
# - Variables with PUBLIC_ prefix are exposed to client-side
# - Variables without PUBLIC_ are server-side only
# - Never commit sensitive keys to Git
# - Add .env to .gitignore
