---
// About Section Component
---

<section id="about" class="py-section px-6">
  <div class="max-w-container mx-auto">
    <h2 class="text-4xl md:text-5xl font-bold mb-16 text-center fade-in">About Me</h2>
    
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Photo -->
      <div class="fade-in">
        <div class="aspect-square rounded-lg overflow-hidden" style="background-color: var(--color-brand-gray-light);">
          <img 
            src="/images/profile.jpg" 
            alt="Profile" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
      
      <!-- Bio & Stats -->
      <div class="fade-in fade-in-delay-1">
        <p class="text-lg leading-relaxed-custom mb-6" style="color: var(--color-brand-gray-dark);">
          I'm a Software Engineering Technical Lead and Full-Stack Engineer with 9+ years of experience 
          delivering end-to-end solutions across mobile applications and back-end systems.
        </p>
        <p class="text-lg leading-relaxed-custom mb-8" style="color: var(--color-brand-gray-dark);">
          Strong background in architecting scalable, modular platforms, defining robust API contracts, 
          and driving technical decisions across teams. Hands-on experience in Android, cross-platform 
          mobile development, and back-end integration with expertise in Java, Kotlin, React Native, 
          and modern architectural patterns such as Clean Architecture and MVVM.
        </p>
        
        <!-- Key Stats -->
        <div class="grid grid-cols-3 gap-6 mb-8">
          <div class="text-center">
            <div class="text-3xl font-bold mb-1" style="color: var(--color-brand-orange);">9+</div>
            <div class="text-sm" style="color: var(--color-brand-gray-dark);">Years Exp</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold mb-1" style="color: var(--color-brand-orange);">7+</div>
            <div class="text-sm" style="color: var(--color-brand-gray-dark);">Companies</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold mb-1" style="color: var(--color-brand-orange);">10+</div>
            <div class="text-sm" style="color: var(--color-brand-gray-dark);">Projects</div>
          </div>
        </div>
        
        <!-- Resume Button -->
        <a 
          href="/resume.pdf" 
          download
          class="inline-flex items-center gap-2 px-6 py-3 border rounded-lg hover-bg-brand-black hover:text-white transition-all duration-300 font-medium"
          style="border-color: var(--color-brand-black);"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Resume
        </a>
      </div>
    </div>
  </div>
</section>
