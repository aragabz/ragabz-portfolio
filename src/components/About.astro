---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const shippedWith = ['VOIS', 'CodeBeam', 'Squadio', 'Elnooronline', 'Arabsat', 'Modeso', 'TE-Data'];
---

<section id="about" class="wrap section" aria-labelledby="about-heading">
  <div class="about">
    <Image
      src={profilePhoto}
      alt="Ahmed Ragab"
      widths={[320, 480, 720]}
      sizes="(min-width: 900px) 360px, 70vw"
      format="webp"
      quality={80}
      class="about-photo"
      loading="lazy"
    />

    <div>
      <h2 id="about-heading" class="section-title">About</h2>

      <p class="about-lead">
        I started in 2017 writing Java for a telecom's customer-care tools, moved to Android a year later and never
        fully left. These days I lead a team at VOIS, where I split my week between a Kotlin app, the Spring Boot
        services behind it, and the Kafka, Airflow and NiFi plumbing underneath.
      </p>
      <p class="about-line">
        I like clean module boundaries, boring deployments, and API contracts that both teams actually agreed to.
      </p>

      <div class="shipped">
        <p class="mono-caps">Shipped with</p>
        <p class="shipped-list">{shippedWith.join(' · ')}</p>
      </div>

      <a href={`${base}about`} class="text-link">Full experience <span aria-hidden="true">&nbsp;→</span></a>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    align-items: start;
    gap: 64px;
  }

  .about-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 15%;
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .about-lead {
    max-width: 40rem;
    margin-top: 28px;
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .about-line {
    max-width: 40rem;
    margin-top: 18px;
  }

  .shipped {
    margin-block: 32px 12px;
    padding-top: 20px;
    border-top: 1px solid var(--color-hairline);
  }

  .shipped-list {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .about-photo {
      max-width: 280px;
    }
  }
</style>
