---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const blogPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  }).format(date);
}
---

<section id="blog" class="py-section px-6 bg-white">
  <div class="max-w-container mx-auto">
    <div class="text-center mb-16 fade-in">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">Latest Articles</h2>
      <p style="color: var(--color-brand-gray-dark);">Thoughts on software development, tech, and learning</p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {blogPosts.map((post, index) => (
        <article class={`bg-white border rounded-lg overflow-hidden card-hover fade-in fade-in-delay-${Math.min(index + 1, 3)}`} style="border-color: var(--color-brand-gray-light);">
          <div class="p-6">
            <div class="flex items-center gap-3 text-sm mb-3" style="color: var(--color-brand-gray-dark);">
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <span>•</span>
              <span>{post.data.readingTime || 5} min read</span>
            </div>
            
            <h3 class="text-xl font-semibold mb-3 hover-text-brand-orange transition-colors">
              <a href={`${base}blog/${post.id}`}>
                {post.data.title}
              </a>
            </h3>
            
            <p class="mb-4 leading-relaxed-custom" style="color: var(--color-brand-gray-dark);">
              {post.data.excerpt}
            </p>
            
            <div class="flex flex-wrap gap-2 mb-4">
              {post.data.tags.slice(0, 3).map(tag => (
                <span class="text-xs px-3 py-1 rounded-full" style="background-color: var(--color-brand-gray-light); color: var(--color-brand-gray-dark);">
                  {tag}
                </span>
              ))}
            </div>
            
            <a 
              href={`${base}blog/${post.id}`}
              class="text-sm font-medium hover-text-brand-orange transition-colors"
              style="color: var(--color-brand-black);"
            >
              Read More →
            </a>
          </div>
        </article>
      ))}
    </div>
    
    {blogPosts.length === 0 && (
      <p class="text-center" style="color: var(--color-brand-gray-dark);">Coming soon! Stay tuned for articles.</p>
    )}
    
    {blogPosts.length > 0 && (
      <div class="text-center mt-12">
        <a 
          href={`${base}blog`}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold transition-all hover:scale-105 hover:shadow-lg"
          style="background-color: var(--color-brand-orange); color: white;"
        >
          See More Articles
          <span style="font-size: 1.2rem;">→</span>
        </a>
      </div>
    )}
  </div>
</section>
