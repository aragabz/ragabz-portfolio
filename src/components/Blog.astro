---
// Home "Writing" section: the latest post as a big lime card, the next two as white cards.
import { getVisibleBlogPosts, byNewest, readingTime, formatDate } from '../utils/blog';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const [latest, ...rest] = (await getVisibleBlogPosts()).sort(byNewest).slice(0, 3);
---

<section class="wrap section" aria-labelledby="writing-heading">
  <div class="section-head">
    <div>
      <h2 id="writing-heading" class="section-title">Writing</h2>
      <p class="section-sub">Long, practical guides. Mostly Kotlin, sometimes the server side of it.</p>
    </div>
    <a href={`${base}blog`} class="text-link">All posts <span aria-hidden="true">&nbsp;→</span></a>
  </div>

  {latest && (
    <div class="writing-grid">
      <article class="post-card post-card-lead">
        <p class="mono post-meta">{readingTime(latest)} min read · {formatDate(latest.data.date)}</p>
        <h3><a href={`${base}blog/${latest.id}`}>{latest.data.title}</a></h3>
        <p class="post-excerpt">{latest.data.excerpt}</p>
        <ul class="post-tags" aria-label="Tags">
          {latest.data.tags.slice(0, 4).map((tag) => <li class="chip chip-on-lime">{tag}</li>)}
        </ul>
      </article>

      {rest.map((post) => (
        <article class="post-card">
          <p class="mono post-meta">{readingTime(post)} min read · {formatDate(post.data.date)}</p>
          <h3><a href={`${base}blog/${post.id}`}>{post.data.title}</a></h3>
          <p class="post-excerpt">{post.data.excerpt}</p>
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .writing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 20px;
  }

  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .post-card:hover {
    border-color: var(--color-ink);
  }

  .post-card-lead {
    grid-row: span 2;
    padding: 36px;
    border-color: var(--color-lime);
    background: var(--color-lime);
  }

  .post-meta {
    margin-bottom: 16px;
  }

  .post-card-lead .post-meta,
  .post-card-lead .post-excerpt {
    color: var(--color-ink);
  }

  h3 {
    font-size: 1.5rem;
    line-height: 1.1;
    text-wrap: balance;
  }

  .post-card-lead h3 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.02;
  }

  /* The whole card is the link target; the title carries the accessible name. */
  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  .post-card:hover h3 a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .post-excerpt {
    margin-top: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-lead .post-excerpt {
    max-width: 32rem;
    font-size: 1.125rem;
    -webkit-line-clamp: 5;
    line-clamp: 5;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: auto 0 0;
    padding: 32px 0 0;
    list-style: none;
  }

  @media (max-width: 800px) {
    .writing-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-card-lead {
      padding: 28px;
    }
  }
</style>
