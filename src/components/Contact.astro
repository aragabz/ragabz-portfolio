---
import ContactForm from './react/ContactForm';

const email = 'ahmedragab.se@gmail.com';
const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/aragabz/' },
  { label: 'GitHub', href: 'https://github.com/aragabz' },
  { label: 'X', href: 'https://twitter.com/aragabz' },
];
---

<div class="contact">
  <div>
    <h1 class="page-title">Say hello</h1>
    <p class="page-intro">
      I'm happy to talk about Android, Kotlin on the server, or data migrations that keep you up at night. Use the
      form, or write to me directly.
    </p>

    <div class="contact-links">
      <a href={`mailto:${email}`} class="btn btn-primary">{email}</a>
      {socials.map((social) => (
        <a href={social.href} class="btn btn-outline" rel="noopener noreferrer">{social.label}</a>
      ))}
    </div>
  </div>

  <div class="contact-form">
    <ContactForm client:visible />
  </div>
</div>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 64px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .contact-links .btn-primary {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .contact-form {
    padding: clamp(20px, 4vw, 36px);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
</style>
