---
import CodeCard from './CodeCard.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section class="wrap hero">
  <div>
    <p class="mono hero-status"><span class="dot" aria-hidden="true"></span>Tech lead at VOIS · Alexandria, Egypt</p>

    <h1>I build Android apps <span class="hl">and the backends</span> they talk to.</h1>

    <p class="hero-intro">
      Hi, I'm Ahmed Ragab. Nine years of Kotlin, Spring Boot and Kafka, a couple of open-source templates I keep
      alive, and very long guides about Kotlin. I once moved 100 million rows between databases without losing one,
      and I'm still a little smug about it.
    </p>

    <div class="hero-actions">
      <a href={`${base}blog`} class="btn btn-primary">Read the blog <span aria-hidden="true">→</span></a>
      <a href="https://github.com/aragabz" class="btn btn-outline" rel="noopener noreferrer">github.com/aragabz</a>
    </div>
  </div>

  <div class="hero-card">
    <CodeCard />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    padding-block: 56px 80px;
  }

  .hero-status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .dot {
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--color-dot);
  }

  h1 {
    font-size: clamp(2.75rem, 6.6vw, 5.25rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .hero-intro {
    max-width: 36rem;
    margin-top: 28px;
    font-size: 1.125rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-block: 32px 64px;
    }
  }
</style>
