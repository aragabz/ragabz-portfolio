---
// Hero Section Component
import TechStackMarquee from './react/TechStackMarquee';
import { defaultTechStack } from './react/TechStackMarquee';
---

<section id="hero" class="min-h-screen flex items-center justify-center px-6 flex-col">
  <div class="max-w-container mx-auto text-center flex-1 flex flex-col justify-center">
    <h1 class="text-6xl md:text-8xl font-bold mb-6 fade-in tracking-tight-2">
      Ahmed Ragab
    </h1>
    <h2 class="text-2xl md:text-3xl mb-6 fade-in fade-in-delay-1" style="color: var(--color-brand-gray-dark);">
      Software Engineering Technical Lead | Full-Stack Engineer
    </h2>
    <p class="text-lg md:text-xl max-w-2xl mx-auto mb-12 leading-relaxed-custom fade-in fade-in-delay-2" style="color: var(--color-brand-gray-dark);">
      Building scalable, end-to-end solutions across mobile and back-end systems.
      Passionate about clean architecture, performance, and user-centric design.
    </p>
    
    <div class="flex gap-4 justify-center fade-in fade-in-delay-3">
      <a 
        href="#contact" 
        class="px-8 py-4 text-white rounded-lg hover-bg-brand-orange transition-colors duration-300 font-medium"
        style="background-color: var(--color-brand-black);"
      >
        Get in Touch
      </a>
      <a 
        href="#projects" 
        class="px-8 py-4 border rounded-lg hover-border-brand-gray-dark transition-colors duration-300 font-medium"
        style="border-color: var(--color-brand-gray-light);"
      >
        View Work
      </a>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="mt-20 fade-in fade-in-delay-3">
      <a href="#about" class="inline-block animate-bounce">
        <svg 
          class="w-6 h-6" 
          style="color: var(--color-brand-gray-dark);"
          fill="none" 
          stroke="currentColor" 
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </div>
  
  <!-- Tech Stack Marquee -->
  <div class="w-full max-w-7xl mx-auto fade-in fade-in-delay-4">
    <TechStackMarquee 
      items={defaultTechStack} 
      speed={50}
      pauseOnHover={true}
      client:visible
    />
  </div>
</section>
