---
// Hero Section Component
import HeroBackground from './HeroBackground.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section id="hero" class="relative overflow-hidden min-h-screen flex items-center justify-center px-6 flex-col pt-28">
  <HeroBackground />

  <div class="relative z-10 max-w-container mx-auto text-center flex-1 flex flex-col justify-center">
    <h1 class="text-6xl md:text-8xl font-bold mb-6 fade-in tracking-tight-2">
      Ahmed Ragab
    </h1>
    <h2 class="text-2xl md:text-3xl mb-6 fade-in fade-in-delay-1" style="color: var(--color-brand-gray-dark);">
      Software Engineering Technical Lead
    </h2>
    <p class="text-lg md:text-xl max-w-2xl mx-auto mb-12 leading-relaxed-custom fade-in fade-in-delay-2" style="color: var(--color-brand-gray-dark);">
      Specializing in scalable, end-to-end systems across mobile and backend architectures.
      Hands-on expertise with Native Mobile, React Native, Kotlin Multiplatform (KMP), and modern backend systems. Driven by clean architecture, performance optimization, and robust engineering design.
    </p>
    
    <div class="flex gap-4 justify-center fade-in fade-in-delay-3">
      <a 
        href={`${base}contact`} 
        class="px-8 py-4 rounded-lg transition-colors duration-300 font-medium hover:bg-[var(--color-accent-strong)]"
        style="background-color: var(--color-accent); color: #ffffff;"
      >
        Get in Touch
      </a>
      <a 
        href={`${base}#projects`}
        class="px-8 py-4 border rounded-lg hover-border-brand-black transition-colors duration-300 font-medium"
        style="border-color: var(--color-border-secondary); color: var(--color-text);"
      >
        View Work
      </a>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="mt-20 fade-in fade-in-delay-3">
      <a href="#about" class="inline-block animate-bounce" aria-label="Scroll to About">
        <svg 
          class="w-6 h-6" 
          style="color: var(--color-brand-gray-dark);"
          fill="none" 
          stroke="currentColor" 
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </div>
</section>
