---
// Decorative 3D node network behind the hero. The CSS glow on .hero-network is
// the fallback (no WebGL, Save-Data, or before the scene loads); three.js is
// only fetched once the browser is idle, so it never delays the hero text.
---

<div class="hero-network" aria-hidden="true">
  <canvas id="hero-network-canvas"></canvas>
</div>

<script>
  let cleanup: (() => void) | undefined;

  function init() {
    const canvas = document.getElementById('hero-network-canvas') as HTMLCanvasElement | null;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (!canvas || saveData) return;

    const start = () =>
      import('../scripts/hero-network').then(({ mountHeroNetwork }) => {
        if (canvas.isConnected) cleanup = mountHeroNetwork(canvas);
      });
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2000 });
    else setTimeout(start, 200);
  }

  // Fires on the initial load and after every view-transition navigation.
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style>
  .hero-network {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      color-mix(in srgb, var(--color-accent) 10%, transparent),
      transparent 70%
    );
    /* Dim the network behind the text block and fade it out at the edges,
       so it frames the content without competing with it. */
    mask-image: radial-gradient(
      ellipse 75% 70% at 50% 45%,
      rgb(0 0 0 / 0.15) 0%,
      rgb(0 0 0 / 0.25) 25%,
      black 55%,
      transparent 100%
    );
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  canvas:global(.is-ready) {
    opacity: 1;
  }
</style>
