---
import { LEVELS, LEVEL_LABELS, type Level } from '../utils/levels';

interface Props {
  level: Level;
}

const { level } = Astro.props;
const rank = LEVELS.indexOf(level) + 1;
---

<span class="level-badge" title={`Level: ${LEVEL_LABELS[level]} (${rank} of ${LEVELS.length})`}>
  <span class="level-dots" aria-hidden="true">
    {LEVELS.map((_, i) => <span class={i < rank ? 'is-on' : undefined} />)}
  </span>
  {LEVEL_LABELS[level]}
</span>
