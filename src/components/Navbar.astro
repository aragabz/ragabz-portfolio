---
import Search from './react/Search';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const path = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { href: `${base}blog`, label: 'Writing', current: path.includes('/blog') },
  { href: `${base}#projects`, label: 'Projects', current: path.includes('/projects') },
  { href: `${base}#about`, label: 'About', current: path.endsWith('/about') },
  // Hidden from the nav for now; the /uses page itself still exists. Drop `hidden` to bring it back.
  { href: `${base}uses`, label: 'Uses', current: path.endsWith('/uses'), hidden: true },
].filter((link) => !link.hidden);
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a href={base} class="wordmark" aria-label="aragabz, home">
      aragabz<span class="wordmark-cursor" aria-hidden="true">_</span>
    </a>

    <nav aria-label="Main navigation">
      <ul class="site-nav">
        {links.map((link) => (
          <li>
            <a href={link.href} class="site-nav-link" aria-current={link.current ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <Search client:idle />
        </li>
        <li>
          <a href={`${base}resume.pdf`} class="btn btn-outline resume-pill">Resume</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-block: 20px;
  }

  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .wordmark-cursor {
    margin-left: 1px;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark-cursor {
      animation: none;
    }
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-nav-link:hover,
  .site-nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.3em;
  }

  .resume-pill {
    min-height: 44px;
    padding: 0 20px;
    margin-left: 6px;
  }

  /* Small screens: the nav wraps under the wordmark; links lose their side padding so the
     row lines up with the page gutter. */
  @media (max-width: 520px) {
    .site-nav {
      gap: 4px 16px;
    }

    .site-nav-link {
      min-width: 44px;
      padding: 0;
    }

    .resume-pill {
      margin-left: 0;
    }
  }
</style>
