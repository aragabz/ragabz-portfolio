---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const isNpm = (url: string) => /npmjs\.com/.test(url);
---

<section id="projects" class="wrap section" aria-labelledby="projects-heading">
  <div class="section-head">
    <div>
      <h2 id="projects-heading" class="section-title">Projects</h2>
      <p class="section-sub">Starter templates I use myself, so they stay maintained.</p>
    </div>
  </div>

  <div class="project-grid">
    {projects.map(({ id, data }) => (
      <article class="project-card on-dark">
        <div class="project-top">
          <p class="project-meta">{data.category}{data.year && ` · ${data.year}`}</p>
          {data.status && <span class="chip chip-lime">{data.status.toLowerCase()}</span>}
        </div>

        <h3>{data.title}</h3>
        <p class="project-desc">{data.description}</p>
        <p class="project-stack">{data.tech.join(' · ')}</p>

        <div class="project-actions">
          {data.github && (
            <a href={data.github} class="btn btn-lime" rel="noopener noreferrer">
              View on GitHub<span class="sr-only">: {data.title}</span>
            </a>
          )}
          {data.live && (
            <a href={data.live} class="btn btn-lime" rel="noopener noreferrer">
              {isNpm(data.live) ? 'View on npm' : 'View live'}<span class="sr-only">: {data.title}</span>
            </a>
          )}
          <a href={`${base}projects/${id}`} class="btn btn-outline-light">
            Read more<span class="sr-only"> about {data.title}</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: 32px;
    border-radius: var(--radius-card);
    background: var(--color-dark);
    color: var(--color-dark-secondary);
  }

  .project-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 28px;
  }

  .project-meta,
  .project-stack {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-dark-muted);
  }

  h3 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.05;
    color: var(--color-dark-text);
    text-wrap: balance;
  }

  .project-desc {
    margin-top: 14px;
  }

  .project-stack {
    margin-top: 20px;
    color: var(--color-dark-secondary);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
    padding-top: 32px;
  }

  @media (max-width: 800px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-card {
      padding: 24px;
    }
  }
</style>
