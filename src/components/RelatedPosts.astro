---
import { getVisibleBlogPosts } from '../utils/blog';
import LevelBadge from './LevelBadge.astro';

interface Props {
  currentSlug: string;
  currentTags: string[];
  /** Posts in the same series are reachable from the series navigation, so they're left out here. */
  currentSeries?: string;
  limit?: number;
}

const { currentSlug, currentTags, currentSeries, limit = 3 } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const allPosts = await getVisibleBlogPosts();

const relatedPosts = allPosts
  .filter(post => post.id !== currentSlug && (!currentSeries || post.data.series !== currentSeries))
  .map(post => ({
    post,
    matchCount: post.data.tags.filter(tag => currentTags.includes(tag)).length
  }))
  .filter(({ matchCount }) => matchCount > 0)
  .sort((a, b) => b.matchCount - a.matchCount || b.post.data.date.getTime() - a.post.data.date.getTime())
  .slice(0, limit)
  .map(({ post }) => post);
---

{relatedPosts.length > 0 && (
  <section class="related" aria-labelledby="related-heading">
    <h2 id="related-heading">Related articles</h2>
    <ul>
      {relatedPosts.map(post => (
        <li class="related-row">
          <h3>
            <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
          </h3>
          <p>{post.data.excerpt}</p>
          <div class="related-meta">
            {post.data.level && <LevelBadge level={post.data.level} />}
            <span>{post.data.readingTime || 5} min read</span>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related {
    margin-top: 4rem;
  }
  .related h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .related ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .related-row {
    position: relative;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .related-row h3 {
    margin: 0 0 0.375rem;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--color-text);
    transition: color 0.2s ease;
  }
  .related-row a {
    color: inherit;
    text-decoration: none;
  }
  .related-row a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .related-row:hover h3 { color: var(--color-accent-strong); }
  .related-row a:focus-visible { outline: none; }
  .related-row:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .related-row p {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
  }
</style>
