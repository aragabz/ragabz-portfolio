---
import type { BlogPost } from '../utils/blog';
import { LEVEL_LABELS } from '../utils/levels';

interface Props {
  series: string;
  posts: BlogPost[]; // all posts in the series, sorted by seriesOrder
  currentId: string;
  variant: 'outline' | 'pager';
}

const { series, posts, currentId, variant } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const index = posts.findIndex((p) => p.id === currentId);
const current = posts[index];
const prev = index > 0 ? posts[index - 1] : undefined;
const next = index < posts.length - 1 ? posts[index + 1] : undefined;

// "Rust Backend, Part 3: PostgreSQL with SQLx" -> "PostgreSQL with SQLx". The part number is shown separately.
const shortTitle = (p: BlogPost) => p.data.title.replace(/^.*?\bPart \d+:\s*/, '').replace(/^.*?Case Study:\s*/, '');
const levelOf = (p: BlogPost) => (p.data.level ? LEVEL_LABELS[p.data.level] : undefined);
// Only call out the level on the pager when it changes, so a jump (Mid -> Staff) is visible before clicking.
const nextLevelChanges = next?.data.level && next.data.level !== current?.data.level;
---

{variant === 'outline' ? (
  <details class="series-outline" data-series-outline>
    <summary>
      <span class="series-name">{series}</span>
      <span class="series-position">
        Part {index + 1} of {posts.length}
        <span class="series-toggle" aria-hidden="true"></span>
      </span>
    </summary>
    <ol>
      {posts.map((p) => (
        <li class={p.id === currentId ? 'is-current' : undefined} data-post-id={p.id}>
          {p.id === currentId ? (
            <span aria-current="page">{shortTitle(p)}</span>
          ) : (
            <a href={`${base}blog/${p.id}`}>{shortTitle(p)}</a>
          )}
          <span class="series-read" hidden>
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="sr-only">read</span>
          </span>
          {levelOf(p) && <span class="series-level">{levelOf(p)}</span>}
        </li>
      ))}
    </ol>
  </details>
) : (
  <nav class="series-end" aria-label={`${series}: next and previous parts`}>
    <div class="series-progress">
      <p><span class="series-progress-count">Part {index + 1} of {posts.length}</span> in {series}</p>
      <ol class="series-segments" aria-hidden="true">
        {posts.map((p, i) => <li class={i < index ? 'is-done' : i === index ? 'is-current' : undefined} title={shortTitle(p)} />)}
      </ol>
    </div>

    <div class="series-pager">
      {prev ? (
        <a href={`${base}blog/${prev.id}`} class="series-pager-link">
          <span class="series-pager-meta">← Previous · Part {index}</span>
          <span class="series-pager-title">{shortTitle(prev)}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={`${base}blog/${next.id}`} class="series-pager-link is-next">
          <span class="series-pager-meta">
            Next · Part {index + 2}{nextLevelChanges && <> · {levelOf(next)}</>} →
          </span>
          <span class="series-pager-title">{shortTitle(next)}</span>
        </a>
      ) : (
        <div class="series-pager-done">
          <span class="series-pager-meta">Series complete</span>
          <span class="series-pager-title">You've reached the last part of {series}.</span>
        </div>
      )}
    </div>
  </nav>
)}

<style>
  .series-outline {
    margin: 0 0 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-secondary);
  }
  .series-outline summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    border-radius: 0.75rem;
  }
  .series-outline summary::-webkit-details-marker { display: none; }
  .series-name {
    font-weight: 600;
    color: var(--color-text);
  }
  .series-position {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
  }
  .series-toggle::after {
    content: 'Show all parts';
    color: var(--color-accent-strong);
  }
  .series-outline[open] .series-toggle::after { content: 'Hide parts'; }
  .series-outline ol {
    margin: 0;
    padding: 0 1.25rem 1rem 3rem;
    list-style: decimal;
    font-size: 0.9375rem;
    color: var(--color-text-tertiary);
  }
  .series-outline li {
    padding: 0.3125rem 0;
    font-variant-numeric: tabular-nums;
  }
  .series-outline li::marker { color: var(--color-text-tertiary); }
  .series-outline li a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .series-outline li a:hover { color: var(--color-accent-strong); }
  .series-outline li.is-current { color: var(--color-text); font-weight: 600; }
  .series-outline li.is-current::marker { color: var(--color-accent-strong); }
  .series-read {
    display: inline-flex;
    margin-left: 0.375rem;
    color: var(--color-accent-strong);
    vertical-align: -1px;
  }
  .series-read[hidden] { display: none; }
  .series-level {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-tertiary);
  }

  .series-end {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .series-progress p {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
  }
  .series-progress-count {
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .series-segments {
    display: flex;
    gap: 4px;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .series-segments li {
    flex: 1;
    height: 4px;
    border-radius: 999px;
    background: var(--color-border);
  }
  .series-segments li.is-done { background: color-mix(in srgb, var(--color-accent) 45%, var(--color-border)); }
  .series-segments li.is-current { background: var(--color-accent); }

  .series-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .series-pager-link,
  .series-pager-done {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .series-pager-link:hover { border-color: var(--color-accent-strong); }
  .series-pager-link.is-next {
    text-align: right;
    grid-column: 2;
    background: var(--color-bg-secondary);
  }
  .series-pager-done { grid-column: 2; text-align: right; background: var(--color-bg-secondary); }
  .series-pager-meta {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
  }
  .series-pager-link.is-next .series-pager-meta { color: var(--color-accent-strong); font-weight: 600; }
  .series-pager-title {
    font-weight: 600;
    line-height: 1.4;
    text-wrap: balance;
  }
  @media (max-width: 640px) {
    .series-pager { grid-template-columns: 1fr; }
    .series-pager-link.is-next,
    .series-pager-done { grid-column: 1; order: -1; }
  }
</style>
