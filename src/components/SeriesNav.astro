---
import type { BlogPost } from '../utils/blog';
import { LEVEL_LABELS } from '../utils/levels';

interface Props {
  series: string;
  posts: BlogPost[]; // all posts in the series, sorted by seriesOrder
  currentId: string;
  variant: 'outline' | 'pager';
}

const { series, posts, currentId, variant } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const index = posts.findIndex((p) => p.id === currentId);
const prev = index > 0 ? posts[index - 1] : undefined;
const next = index < posts.length - 1 ? posts[index + 1] : undefined;
---

{variant === 'outline' ? (
  <details class="series-outline">
    <summary>
      <span class="series-kicker">Series · Part {index + 1} of {posts.length}</span>
      <span class="series-name">{series}</span>
    </summary>
    <ol>
      {posts.map((p) => (
        <li class={p.id === currentId ? 'is-current' : undefined}>
          {p.id === currentId ? (
            <span aria-current="page">{p.data.title}</span>
          ) : (
            <a href={`${base}blog/${p.id}`}>{p.data.title}</a>
          )}
          {p.data.level && <span class="series-level">{LEVEL_LABELS[p.data.level]}</span>}
        </li>
      ))}
    </ol>
  </details>
) : (
  <nav class="series-pager" aria-label={`${series} navigation`}>
    {prev ? (
      <a href={`${base}blog/${prev.id}`} class="series-pager-link">
        <span class="series-kicker">← Previous</span>
        <span>{prev.data.title}</span>
      </a>
    ) : <span />}
    {next && (
      <a href={`${base}blog/${next.id}`} class="series-pager-link is-next">
        <span class="series-kicker">Next →</span>
        <span>{next.data.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .series-outline {
    margin: 0 0 3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-secondary);
  }
  .series-outline summary {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }
  .series-outline summary::-webkit-details-marker { display: none; }
  .series-outline summary::after {
    content: 'Show all parts ▾';
    font-size: 0.8125rem;
    color: var(--color-accent-strong);
  }
  .series-outline[open] summary::after { content: 'Hide parts ▴'; }
  .series-name {
    font-weight: 600;
    color: var(--color-text);
  }
  .series-kicker {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-tertiary);
  }
  .series-outline ol {
    margin: 0;
    padding: 0 1.25rem 1.25rem 2.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }
  .series-outline li { padding: 0.25rem 0; }
  .series-outline li a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .series-outline li a:hover { color: var(--color-accent-strong); }
  .series-outline li.is-current { color: var(--color-text); font-weight: 600; }
  .series-level {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }
  .series-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
  }
  .series-pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    transition: border-color 0.2s ease;
  }
  .series-pager-link:hover { border-color: var(--color-accent); }
  .series-pager-link.is-next { text-align: right; grid-column: 2; }
  @media (max-width: 640px) {
    .series-pager { grid-template-columns: 1fr; }
    .series-pager-link.is-next { grid-column: 1; }
  }
</style>
