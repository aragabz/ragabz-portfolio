---
// Skills Section Component
const skills = [
  'Java',
  'Kotlin',
  'TypeScript',
  'Swift',
  'React Native',
  'Android',
  'iOS',
  'React',
  'Next.js',
  'Spring Boot',
  'Node.js',
  'PostgreSQL',
  'CockroachDB',
  'MongoDB',
  'Redis',
  'Docker',
  'Kafka',
  'Git',
  'CI/CD',
  'Clean Architecture',
  'MVVM',
  'API Design',
];
---

<section id="skills" class="py-section px-6 bg-[var(--color-bg)]">
  <div class="max-w-container mx-auto">
    <h2 class="text-4xl md:text-5xl font-bold mb-16 text-center fade-in">Skills & Expertise</h2>
    
    <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto fade-in fade-in-delay-1">
      {skills.map(skill => (
        <span
          class="px-4 py-2 rounded-full text-sm transition-colors duration-300 cursor-default hover-bg-brand-black hover:text-white"
          style="background-color: var(--color-brand-gray-light); color: var(--color-brand-gray-dark);"
        >
          {skill}
        </span>
      ))}
    </div>
  </div>
</section>
