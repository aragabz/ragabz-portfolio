---
// Skills Section Component
const skills = {
  Languages: ['JavaScript', 'TypeScript', 'Python', 'Go', 'SQL'],
  'Frontend': ['React', 'Next.js', 'Vue', 'Tailwind CSS', 'Astro'],
  'Backend': ['Node.js', 'Express', 'PostgreSQL', 'MongoDB', 'Redis'],
  'Tools & Cloud': ['Git', 'Docker', 'AWS', 'Vercel', 'CI/CD'],
};
---

<section id="skills" class="py-section px-6 bg-white">
  <div class="max-w-container mx-auto">
    <h2 class="text-4xl md:text-5xl font-bold mb-16 text-center fade-in">Skills & Expertise</h2>
    
    <div class="grid md:grid-cols-2 gap-8">
      {Object.entries(skills).map(([category, items], index) => (
        <div class={`fade-in fade-in-delay-${Math.min(index + 1, 3)}`}>
          <h3 class="text-xl font-semibold mb-4">{category}</h3>
          <div class="flex flex-wrap gap-3">
            {items.map(skill => (
              <span
                class="px-4 py-2 rounded-full text-sm hover-bg-brand-black hover:text-white transition-colors duration-300 cursor-default"
                style="background-color: var(--color-brand-gray-light); color: var(--color-brand-gray-dark);"
              >
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
