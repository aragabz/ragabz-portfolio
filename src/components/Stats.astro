---
import { getVisibleBlogPosts, readingTime } from '../utils/blog';

// Computed at build time: the sum of every published post's reading time.
const minutes = (await getVisibleBlogPosts()).reduce((sum, post) => sum + readingTime(post), 0);

const stats = [
  { value: '9+', label: 'years shipping' },
  { value: '7', label: 'companies' },
  { value: '10+', label: 'projects' },
  { value: minutes.toLocaleString('en-US'), label: 'minutes of Kotlin to read on this site' },
];
---

<section class="wrap" aria-label="In numbers">
  <dl class="stats">
    {stats.map((stat) => (
      <div>
        <dt>{stat.value}</dt>
        <dd>{stat.label}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.6fr);
    gap: 24px 32px;
    margin: 0;
    padding-block: 28px;
    border-block: 1px solid var(--color-hairline);
  }

  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
  }

  dt {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-ink);
  }

  dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (max-width: 800px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
