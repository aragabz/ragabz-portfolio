---
interface Props {
  variant?: 'note' | 'tip' | 'warning';
  title?: string;
}

const { variant = 'note', title } = Astro.props;

const labels: Record<string, string> = {
  note: 'Note',
  tip: 'Tip',
  warning: 'Warning',
};
---

<div class="callout callout-{variant}">
  <p class="callout-label">
    {title ?? labels[variant]}
  </p>
  <div class="callout-body">
    <slot />
  </div>
</div>

<style>
  .callout {
    margin: 2.5rem 0;
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    border-left-width: 3px;
    border-left-color: var(--color-accent);
    background: var(--color-bg-secondary);
  }

  .callout-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent-strong);
    margin-bottom: 0.625rem;
  }

  .callout-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .callout-body :global(p),
  .callout-body :global(ul),
  .callout-body :global(ol) {
    margin: 0;
  }

  .callout-body :global(p + p),
  .callout-body :global(ul),
  .callout-body :global(ol) {
    margin-top: 0.75rem;
  }

  .callout-body :global(li) {
    margin-bottom: 0.375rem;
  }

  .callout-body :global(code) {
    background-color: var(--color-bg-tertiary);
    color: var(--color-accent-strong);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.85em;
  }
</style>
