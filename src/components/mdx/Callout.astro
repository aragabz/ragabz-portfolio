---
interface Props {
  variant?: 'note' | 'tip' | 'warning';
  title?: string;
}

const { variant = 'note', title } = Astro.props;

// Every callout is the same lime box; the mono label carries the meaning.
const labels: Record<string, string> = {
  note: 'Heads up',
  tip: 'Tip',
  warning: 'Warning',
};
const label = title ?? labels[variant];
---

<aside class="callout" aria-label={label}>
  <p class="callout-label">{label}</p>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 2.25rem 0;
    padding: 22px 26px;
    border-radius: var(--radius-card);
    background: var(--color-lime);
    color: var(--color-ink);
  }

  .callout-label {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .callout-body {
    font-size: 1rem;
    line-height: 1.65;
  }

  .callout-body :global(p),
  .callout-body :global(ul),
  .callout-body :global(ol) {
    margin: 0;
  }

  .callout-body :global(p + p),
  .callout-body :global(ul),
  .callout-body :global(ol) {
    margin-top: 0.75rem;
  }

  .callout-body :global(li) {
    margin-bottom: 0.375rem;
  }

  .callout-body :global(strong) {
    color: inherit;
  }

  @media (max-width: 640px) {
    .callout {
      border-radius: 16px;
    }
  }
</style>
