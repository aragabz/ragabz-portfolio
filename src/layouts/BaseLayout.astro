---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

const locales = {
  en: {
    siteName: 'Ahmed Ragab - Portfolio',
    navigation: {
      home: 'Home',
      about: 'About',
      projects: 'Projects',
      blog: 'Blog',
      contact: 'Contact'
    },
    hero: {
      title: 'Ahmed Ragab',
      subtitle: 'Software Engineering Technical Lead',
      cta: 'Get in Touch'
    },
    about: {
      title: 'About Me',
      description: 'Software Engineering Technical Lead with 9+ years of experience delivering end-to-end solutions across mobile and back-end systems.',
      stats: {
        experience: '9+ Years Experience',
        companies: '7+ Companies',
        projects: '10+ Projects'
      }
    },
contact: {
      title: 'Get In Touch',
      description: "Have a project in mind? Let's work together to create something amazing.",
      name: 'Name',
      email: 'Email',
      subject: 'Subject',
      message: 'Message',
      send: 'Send Message'
    },
    footer: {
      copyright: '© 2026 Ahmed Ragab. All rights reserved.',
      madeWith: 'Made with Astro'
    }
  }
};

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title = locales.en.siteName,
  description = locales.en.about.description,
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
  keywords = [
    'Software Engineer',
    'Technical Lead',
    'Full-Stack Engineer',
    'Android',
    'React Native',
    'Kotlin',
    'Java',
    'Mobile Developer',
    'Web Development',
    'TypeScript',
    'React',
    'Swift'
  ],
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image.startsWith('/') && base !== '/' ? `${base}${image.slice(1)}` : image, Astro.site);
const siteName = locales.en.siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Performance & Mobile -->
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    
    <!-- Theme Script (must be before body to prevent flash) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="Ahmed Ragab" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    
    <ClientRouter />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@aragabz" />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Person", "Organization"],
      "name": "Ahmed Ragab",
      "url": Astro.site?.toString(),
      "image": socialImageURL.toString(),
      "jobTitle": "Software Engineering Technical Lead",
      "description": description,
      "sameAs": [
        "https://github.com/aragabz",
        "https://www.linkedin.com/in/aragabz/"
      ],
      "knowsAbout": keywords,
      "founder": "Ahmed Ragab",
      "founded": "2015",
      "location": "Remote"
    })} />
    
    {type === 'article' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "url": canonicalURL.toString(),
        "author": {
          "@type": "Person",
          "name": "Ahmed Ragab"
        },
        "image": socialImageURL.toString(),
        "datePublished": new Date().toISOString(),
        "dateModified": new Date().toISOString(),
        "description": description,
        "mainEntityOfPage": canonicalURL.toString(),
        "keywords": keywords.join(', ')
      })} />
    )}
    
    <!-- Website Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": Astro.site?.toString(),
      "description": description,
      "publisher": {
        "@type": "Person",
        "name": "Ahmed Ragab"
      }
    })} />
    
    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Preload Critical Fonts -->
    <link 
      rel="preload" 
href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    </noscript>
  </head>
  <body>
    <slot />
    
    <Footer />
    
    <!-- Analytics -->
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
    
    <!-- Intersection Observer for fade-in animations -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('animate-in');
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);
        
        document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
      });
    </script>

    <!-- Mermaid.js for diagram rendering -->
    <script is:inline src="/mermaid/mermaid.min.js"></script>
    <script is:inline>
      // Initialize mermaid with startOnLoad to auto-render .mermaid elements
      if (window.mermaid) {
        mermaid.initialize({
          startOnLoad: true,
          theme: 'default',
          securityLevel: 'loose',
          fontFamily: 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace',
          flowchart: {
            useMaxWidth: true,
            htmlLabels: true,
            curve: 'basis'
          }
        });
      }

      // Transform mermaid code blocks to mermaid diagrams
      function transformMermaidBlocks() {
        document.querySelectorAll('.blog-content pre[data-language="mermaid"]').forEach((pre) => {
          const code = pre.querySelector('code');
          if (!code) return;
          
          const mermaidText = code.textContent;
          if (!mermaidText || mermaidText.trim() === '') return;

          // Check if already transformed
          if (pre.dataset.mermaidTransformed === 'true') return;

          // Create a div for mermaid to render into (using text content only)
          const mermaidDiv = document.createElement('div');
          mermaidDiv.className = 'mermaid';
          mermaidDiv.textContent = mermaidText;

          // Replace the pre with the mermaid div
          pre.parentNode.replaceChild(mermaidDiv, pre);
          pre.dataset.mermaidTransformed = 'true';

          // Re-run mermaid on the new element
          if (window.mermaid) {
            try {
              mermaid.run({ nodes: [mermaidDiv] });
            } catch (e) {
              console.warn('Mermaid rendering failed:', e);
            }
          }
        });
      }

      // Initial transform
      function initMermaid() {
        if (window.mermaid) {
          transformMermaidBlocks();
        }
      }

      // Use MutationObserver to catch dynamically added content
      const mermaidObserver = new MutationObserver((mutations) => {
        let shouldTransform = false;
        for (const mutation of mutations) {
          for (const node of mutation.addedNodes) {
            if (node.nodeType === Node.ELEMENT_NODE) {
              if (node.matches && node.matches('.blog-content pre[data-language="mermaid"]')) {
                shouldTransform = true;
                break;
              }
              if (node.querySelector && node.querySelector('.blog-content pre[data-language="mermaid"]')) {
                shouldTransform = true;
                break;
              }
            }
          }
        }
        if (shouldTransform && window.mermaid) {
          transformMermaidBlocks();
        }
      });

      // Start observing
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initMermaid();
          mermaidObserver.observe(document.body, { childList: true, subtree: true });
        });
      } else {
        initMermaid();
        mermaidObserver.observe(document.body, { childList: true, subtree: true });
      }
    </script>
  </body>
</html>
