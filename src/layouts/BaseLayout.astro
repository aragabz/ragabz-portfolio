---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

const siteName = 'Ahmed Ragab';
const defaultDescription =
  'Ahmed Ragab builds Android apps and the backends they talk to. Nine years of Kotlin, Spring Boot and Kafka, plus long practical guides.';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string[];
  noindex?: boolean;
  /** Articles: the post's own date, used for datePublished/dateModified in the JSON-LD. */
  publishedDate?: Date;
}

const {
  title = 'Ahmed Ragab: Android apps and the backends they talk to',
  description = defaultDescription,
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
  publishedDate,
  keywords = [
    'Software Engineer',
    'Technical Lead',
    'Full-Stack Engineer',
    'Android',
    'React Native',
    'Kotlin',
    'Java',
    'Mobile Developer',
    'Web Development',
    'TypeScript',
    'React',
    'Swift'
  ],
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image.startsWith('/') && base !== '/' ? `${base}${image.slice(1)}` : image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Performance & Mobile -->
    <meta name="theme-color" content="#f7f7f4" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="Ahmed Ragab" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    
    <ClientRouter />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@aragabz" />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ahmed Ragab",
      "url": Astro.site?.toString(),
      "image": socialImageURL.toString(),
      "jobTitle": "Senior Software Engineer",
      "description": description,
      "sameAs": [
        "https://github.com/aragabz",
        "https://www.linkedin.com/in/aragabz/"
      ],
      "knowsAbout": keywords,
      "location": "Alexandria, Egypt"
    })} />
    
    {type === 'article' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "url": canonicalURL.toString(),
        "author": {
          "@type": "Person",
          "name": "Ahmed Ragab"
        },
        "image": socialImageURL.toString(),
        "datePublished": (publishedDate ?? new Date()).toISOString(),
        "dateModified": (publishedDate ?? new Date()).toISOString(),
        "description": description,
        "mainEntityOfPage": canonicalURL.toString(),
        "keywords": keywords.join(', ')
      })} />
    )}
    
    <!-- Website Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": Astro.site?.toString(),
      "description": description,
      "publisher": {
        "@type": "Person",
        "name": "Ahmed Ragab"
      }
    })} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Navbar />

    <slot />

    <Footer />

    <!-- Mermaid diagrams: loaded on demand, only on pages that contain one -->
    <script>
      import type { MermaidConfig } from 'mermaid';

      const MERMAID_SELECTOR = '.blog-content pre[data-language="mermaid"]';
      let renderCount = 0;

      /** Builds Mermaid's theme from the live color tokens, so diagrams match the page palette. */
      function themeFromTokens(): MermaidConfig {
        const css = getComputedStyle(document.documentElement);
        const token = (name: string) => css.getPropertyValue(name).trim();
        const bg = token('--color-paper');
        const surface = token('--color-card');
        const sunken = token('--color-sunken');
        const text = token('--color-ink');
        const muted = token('--color-muted');
        const border = token('--color-ink');
        const accent = token('--color-ink');
        return {
          startOnLoad: false,
          theme: 'base',
          securityLevel: 'strict',
          fontFamily: "'Geist Variable', Geist, system-ui, sans-serif",
          themeVariables: {
            background: bg,
            fontSize: '15px',
            primaryColor: surface,
            primaryTextColor: text,
            primaryBorderColor: border,
            secondaryColor: sunken,
            secondaryTextColor: text,
            secondaryBorderColor: border,
            tertiaryColor: bg,
            tertiaryTextColor: text,
            tertiaryBorderColor: border,
            lineColor: muted,
            textColor: text,
            mainBkg: surface,
            nodeBorder: border,
            clusterBkg: bg,
            clusterBorder: border,
            edgeLabelBackground: bg,
            titleColor: text,
            actorBkg: surface,
            actorBorder: border,
            actorTextColor: text,
            actorLineColor: border,
            signalColor: muted,
            signalTextColor: text,
            labelBoxBkgColor: surface,
            labelBoxBorderColor: border,
            labelTextColor: text,
            loopTextColor: text,
            noteBkgColor: sunken,
            noteBorderColor: border,
            noteTextColor: text,
            activationBkgColor: sunken,
            activationBorderColor: accent,
            sequenceNumberColor: bg,
            stateBkg: surface,
            stateLabelColor: text,
            altBackground: sunken,
            transitionColor: muted,
            transitionLabelColor: muted,
            attributeBackgroundColorOdd: surface,
            attributeBackgroundColorEven: bg,
          },
          flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'basis' },
          sequence: { useMaxWidth: true },
        };
      }

      /** Short text alternative from the diagram's quoted labels; Mermaid's SVG has none of its own. */
      function describe(source: string): string {
        const kind = source.trim().split(/\s/)[0] ?? 'diagram';
        const name = /^sequence/i.test(kind) ? 'Sequence diagram' : /^state/i.test(kind) ? 'State diagram' : /^er/i.test(kind) ? 'Entity relationship diagram' : 'Diagram';
        const labels = [...new Set([...source.matchAll(/"([^"]{2,80})"/g)].map((m) => m[1].replace(/<br\s*\/?>/gi, ' ')))];
        return labels.length ? `${name}: ${labels.slice(0, 12).join(', ')}` : name;
      }

      async function renderDiagram(mermaid: typeof import('mermaid').default, el: HTMLElement) {
        const source = el.dataset.source ?? '';
        try {
          const { svg, bindFunctions } = await mermaid.render(`mermaid-${++renderCount}`, source);
          el.innerHTML = svg;
          bindFunctions?.(el);
          el.setAttribute('role', 'img');
          el.setAttribute('aria-label', describe(source));
        } catch (error) {
          // Keep the diagram's source readable rather than leaving a broken or empty block.
          console.warn('Mermaid rendering failed:', error);
          el.removeAttribute('role');
          el.removeAttribute('aria-label');
          el.className = 'mermaid-fallback';
          const note = document.createElement('p');
          note.textContent = "This diagram couldn't be drawn. Here is its source:";
          const pre = document.createElement('pre');
          const code = document.createElement('code');
          code.textContent = source;
          pre.append(code);
          el.replaceChildren(note, pre);
          document.getElementById(`dmermaid-${renderCount}`)?.remove();
        }
      }

      async function renderAll(fresh: boolean) {
        if (fresh) {
          document.querySelectorAll<HTMLPreElement>(MERMAID_SELECTOR).forEach((pre) => {
            let source = pre.querySelector('code')?.textContent;
            if (!source?.trim()) return;
            // State diagrams print transition labels verbatim, so `a --> b: "label"` would show its quotes.
            if (/^\s*stateDiagram/.test(source)) source = source.replace(/:\s*"([^"\n]*)"\s*$/gm, ': $1');
            const diagram = document.createElement('div');
            diagram.className = 'mermaid';
            diagram.dataset.source = source;
            pre.replaceWith(diagram);
          });
        }
        const diagrams = Array.from(document.querySelectorAll<HTMLElement>('.mermaid[data-source]'));
        if (diagrams.length === 0) return;

        const { default: mermaid } = await import('mermaid');
        mermaid.initialize(themeFromTokens());
        for (const el of diagrams) await renderDiagram(mermaid, el);
      }

      // Fires on the initial load and after every view-transition navigation.
      document.addEventListener('astro:page-load', () => renderAll(true));
    </script>
  </body>
</html>
