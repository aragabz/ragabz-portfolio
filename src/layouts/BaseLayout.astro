---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

const locales = {
  en: {
    siteName: 'Ahmed Ragab - Portfolio',
    navigation: {
      home: 'Home',
      about: 'About',
      projects: 'Projects',
      blog: 'Blog',
      contact: 'Contact'
    },
    hero: {
      title: 'Ahmed Ragab',
      subtitle: 'Software Engineering Technical Lead',
      cta: 'Get in Touch'
    },
    about: {
      title: 'About Me',
      description: 'Software Engineering Technical Lead with 9+ years of experience delivering end-to-end solutions across mobile and back-end systems.',
      stats: {
        experience: '9+ Years Experience',
        companies: '7+ Companies',
        projects: '10+ Projects'
      }
    },
contact: {
      title: 'Get In Touch',
      description: "Have a project in mind? Let's work together to create something amazing.",
      name: 'Name',
      email: 'Email',
      subject: 'Subject',
      message: 'Message',
      send: 'Send Message'
    },
    footer: {
      copyright: '© 2026 Ahmed Ragab. All rights reserved.',
      madeWith: 'Made with Astro'
    }
  }
};

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string[];
  noindex?: boolean;
  /** Articles: the post's own date, used for datePublished/dateModified in the JSON-LD. */
  publishedDate?: Date;
}

const {
  title = locales.en.siteName,
  description = locales.en.about.description,
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
  publishedDate,
  keywords = [
    'Software Engineer',
    'Technical Lead',
    'Full-Stack Engineer',
    'Android',
    'React Native',
    'Kotlin',
    'Java',
    'Mobile Developer',
    'Web Development',
    'TypeScript',
    'React',
    'Swift'
  ],
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image.startsWith('/') && base !== '/' ? `${base}${image.slice(1)}` : image, Astro.site);
const siteName = locales.en.siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Performance & Mobile -->
    <meta name="theme-color" content="#ffffff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    
    <!-- Theme Script (must be before body to prevent flash) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);
      // Browser chrome follows the page background (--color-bg) in each theme.
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0f172a' : '#ffffff');
    </script>
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="Ahmed Ragab" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    
    <ClientRouter />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@aragabz" />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Person", "Organization"],
      "name": "Ahmed Ragab",
      "url": Astro.site?.toString(),
      "image": socialImageURL.toString(),
      "jobTitle": "Software Engineering Technical Lead",
      "description": description,
      "sameAs": [
        "https://github.com/aragabz",
        "https://www.linkedin.com/in/aragabz/"
      ],
      "knowsAbout": keywords,
      "founder": "Ahmed Ragab",
      "founded": "2015",
      "location": "Remote"
    })} />
    
    {type === 'article' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "url": canonicalURL.toString(),
        "author": {
          "@type": "Person",
          "name": "Ahmed Ragab"
        },
        "image": socialImageURL.toString(),
        "datePublished": (publishedDate ?? new Date()).toISOString(),
        "dateModified": (publishedDate ?? new Date()).toISOString(),
        "description": description,
        "mainEntityOfPage": canonicalURL.toString(),
        "keywords": keywords.join(', ')
      })} />
    )}
    
    <!-- Website Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": Astro.site?.toString(),
      "description": description,
      "publisher": {
        "@type": "Person",
        "name": "Ahmed Ragab"
      }
    })} />
  </head>
  <body>
    <slot />
    
    <Footer />
    
    <!-- Intersection Observer for fade-in animations -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('animate-in');
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);
        
        document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
      });
    </script>

    <!-- Mermaid diagrams: loaded on demand, only on pages that contain one -->
    <script>
      import type { MermaidConfig } from 'mermaid';

      const MERMAID_SELECTOR = '.blog-content pre[data-language="mermaid"]';
      let renderCount = 0;

      /** Builds Mermaid's theme from the live color tokens, so diagrams match whichever theme is active. */
      function themeFromTokens(): MermaidConfig {
        const css = getComputedStyle(document.documentElement);
        const token = (name: string) => css.getPropertyValue(name).trim();
        const bg = token('--color-bg');
        const surface = token('--color-bg-secondary');
        const sunken = token('--color-bg-tertiary');
        const text = token('--color-text');
        const muted = token('--color-text-secondary');
        const border = token('--color-border-secondary');
        const accent = token('--color-accent-strong');
        return {
          startOnLoad: false,
          theme: 'base',
          securityLevel: 'strict',
          fontFamily: "'Inter Variable', Inter, system-ui, sans-serif",
          themeVariables: {
            darkMode: document.documentElement.dataset.theme === 'dark',
            background: bg,
            fontSize: '15px',
            primaryColor: surface,
            primaryTextColor: text,
            primaryBorderColor: border,
            secondaryColor: sunken,
            secondaryTextColor: text,
            secondaryBorderColor: border,
            tertiaryColor: bg,
            tertiaryTextColor: text,
            tertiaryBorderColor: border,
            lineColor: muted,
            textColor: text,
            mainBkg: surface,
            nodeBorder: border,
            clusterBkg: bg,
            clusterBorder: border,
            edgeLabelBackground: bg,
            titleColor: text,
            actorBkg: surface,
            actorBorder: border,
            actorTextColor: text,
            actorLineColor: border,
            signalColor: muted,
            signalTextColor: text,
            labelBoxBkgColor: surface,
            labelBoxBorderColor: border,
            labelTextColor: text,
            loopTextColor: text,
            noteBkgColor: sunken,
            noteBorderColor: border,
            noteTextColor: text,
            activationBkgColor: sunken,
            activationBorderColor: accent,
            sequenceNumberColor: bg,
            stateBkg: surface,
            stateLabelColor: text,
            altBackground: sunken,
            transitionColor: muted,
            transitionLabelColor: muted,
            attributeBackgroundColorOdd: surface,
            attributeBackgroundColorEven: bg,
          },
          flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'basis' },
          sequence: { useMaxWidth: true },
        };
      }

      /** Short text alternative from the diagram's quoted labels; Mermaid's SVG has none of its own. */
      function describe(source: string): string {
        const kind = source.trim().split(/\s/)[0] ?? 'diagram';
        const name = /^sequence/i.test(kind) ? 'Sequence diagram' : /^state/i.test(kind) ? 'State diagram' : /^er/i.test(kind) ? 'Entity relationship diagram' : 'Diagram';
        const labels = [...new Set([...source.matchAll(/"([^"]{2,80})"/g)].map((m) => m[1].replace(/<br\s*\/?>/gi, ' ')))];
        return labels.length ? `${name}: ${labels.slice(0, 12).join(', ')}` : name;
      }

      async function renderDiagram(mermaid: typeof import('mermaid').default, el: HTMLElement) {
        const source = el.dataset.source ?? '';
        try {
          const { svg, bindFunctions } = await mermaid.render(`mermaid-${++renderCount}`, source);
          el.innerHTML = svg;
          bindFunctions?.(el);
          el.setAttribute('role', 'img');
          el.setAttribute('aria-label', describe(source));
        } catch (error) {
          // Keep the diagram's source readable rather than leaving a broken or empty block.
          console.warn('Mermaid rendering failed:', error);
          el.removeAttribute('role');
          el.removeAttribute('aria-label');
          el.className = 'mermaid-fallback';
          const note = document.createElement('p');
          note.textContent = "This diagram couldn't be drawn. Here is its source:";
          const pre = document.createElement('pre');
          const code = document.createElement('code');
          code.textContent = source;
          pre.append(code);
          el.replaceChildren(note, pre);
          document.getElementById(`dmermaid-${renderCount}`)?.remove();
        }
      }

      async function renderAll(fresh: boolean) {
        if (fresh) {
          document.querySelectorAll<HTMLPreElement>(MERMAID_SELECTOR).forEach((pre) => {
            let source = pre.querySelector('code')?.textContent;
            if (!source?.trim()) return;
            // State diagrams print transition labels verbatim, so `a --> b: "label"` would show its quotes.
            if (/^\s*stateDiagram/.test(source)) source = source.replace(/:\s*"([^"\n]*)"\s*$/gm, ': $1');
            const diagram = document.createElement('div');
            diagram.className = 'mermaid';
            diagram.dataset.source = source;
            pre.replaceWith(diagram);
          });
        }
        const diagrams = Array.from(document.querySelectorAll<HTMLElement>('.mermaid[data-source]'));
        if (diagrams.length === 0) return;

        const { default: mermaid } = await import('mermaid');
        mermaid.initialize(themeFromTokens());
        for (const el of diagrams) await renderDiagram(mermaid, el);
      }

      // Fires on the initial load and after every view-transition navigation.
      document.addEventListener('astro:page-load', () => renderAll(true));

      // Theme toggle: redraw diagrams in the new palette and update the browser chrome color.
      new MutationObserver(() => {
        const dark = document.documentElement.dataset.theme === 'dark';
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0f172a' : '#ffffff');
        renderAll(false);
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    </script>
  </body>
</html>
