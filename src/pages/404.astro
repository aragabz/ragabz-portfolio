---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="404 - Page not found" noindex>
  <main id="main-content" tabindex="-1" class="wrap page">
    <p class="mono-caps">Error 404</p>
    <h1 class="page-title">Nothing <span class="hl">lives here.</span></h1>
    <p class="page-intro">
      The link is broken or the page moved. Nothing was lost, it just isn't at this address.
    </p>

    <div class="actions">
      <a href={base} class="btn btn-primary"><span aria-hidden="true">←</span> Back to home</a>
      <a href={`${base}blog`} class="btn btn-outline">Read the blog</a>
      <a href={`${base}contact`} class="btn btn-outline">Get in touch</a>
    </div>
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 60vh;
    padding-top: 72px;
  }

  h1 {
    margin-top: 20px;
  }

  .hl {
    padding: 0 0.12em;
    border-radius: 14px;
    background: var(--color-lime);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
</style>
