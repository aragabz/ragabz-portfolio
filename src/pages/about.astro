---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const target = `${base}#about`;
---

<BaseLayout
  title="About Me - Ahmed Ragab"
  description="Learn more about my background, skills, and professional experience as a Software Engineering Technical Lead."
  noindex
>
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>

  <main id="main-content" role="main" class="min-h-screen flex items-center justify-center px-6 py-24 text-center">
    <p>
      The About section has moved to the home page.
      <a href={target} style="color: var(--color-accent-strong); text-decoration: underline;">Continue to About →</a>
    </p>
  </main>
</BaseLayout>
