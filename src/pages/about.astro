---
import BaseLayout from '../layouts/BaseLayout.astro';
import Experience from '../components/Experience.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout
  title="About - Ahmed Ragab"
  description="Ahmed Ragab's experience: nine years across Android, Kotlin, Spring Boot and data pipelines, from TE-Data to VOIS."
>
  <main id="main-content" tabindex="-1" class="wrap page">
    <div class="page-narrow">
      <h1 class="page-title"><span class="hl">About</span></h1>
      <p class="page-intro">
        I started in 2017 writing Java for a telecom's customer-care tools, moved to Android a year later and never
        fully left. These days I lead a team at VOIS, where I split my week between a Kotlin app, the Spring Boot
        services behind it, and the Kafka, Airflow and NiFi plumbing underneath.
      </p>

      <div class="about-actions">
        <a href={`${base}resume.pdf`} class="btn btn-primary">Resume (PDF)</a>
        <a href={`${base}contact`} class="btn btn-outline">Get in touch</a>
      </div>

      <Experience />
    </div>
  </main>
</BaseLayout>

<style>
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
