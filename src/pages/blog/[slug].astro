---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import profilePhoto from '../../assets/profile.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { getVisibleBlogPosts, byNewest, readingTime, formatDate } from '../../utils/blog';

export async function getStaticPaths() {
  const blogPosts = await getVisibleBlogPosts();
  return blogPosts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const articleURL = new URL(Astro.url.pathname, Astro.site);
const allPosts = (await getVisibleBlogPosts()).sort(byNewest);

const { series } = post.data;
const seriesPosts = series
  ? allPosts
      .filter((p) => p.data.series === series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const isSeries = Boolean(series) && seriesPosts.length > 1;

// Standalone posts page through the whole blog by date; series posts use the series pager instead.
const position = allPosts.findIndex((p) => p.id === post.id);
const newer = position > 0 ? allPosts[position - 1] : undefined;
const older = position < allPosts.length - 1 ? allPosts[position + 1] : undefined;

// "On this page" lists the top-level sections only.
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  type="article"
  publishedDate={post.data.date}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <p class="sr-only" aria-live="polite" data-live-status></p>

  <main id="main-content" tabindex="-1" class="wrap post">
  <article data-article={post.id}>
    <header class="post-head">
      <p class="mono post-meta-line">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post)} min read</span>
        <span aria-hidden="true">·</span>
        <span>{post.data.tags.join(', ')}</span>
      </p>

      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p class="standfirst">{post.data.excerpt}</p>
      {post.data.level && <p class="post-level"><LevelBadge level={post.data.level} /></p>}
    </header>

    <div class="post-layout">
      {toc.length > 0 && (
        <nav class="toc-card" aria-labelledby="toc-heading">
          <h2 id="toc-heading" class="mono-caps">On this page</h2>
          <ol>
            {toc.map((section) => (
              <li><a href={`#${section.slug}`}>{section.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="post-body">
        {isSeries && (
          <SeriesNav series={series!} posts={seriesPosts} currentId={post.id} variant="outline" />
        )}

        <div class="blog-content" data-pagefind-body>
          <Content />
        </div>

        <div class="article-actions">
          <div class="article-share">
            <span class="mono-caps">Share</span>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(articleURL.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn"
            >X</a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleURL.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn"
            >LinkedIn</a>
            <button type="button" class="share-btn" data-copy-link>Copy link</button>
            <button type="button" class="share-btn" data-print>Print</button>
          </div>
        </div>

        <aside class="author-card" aria-label="About the author">
          <Image src={profilePhoto} alt="" width={176} height={220} format="webp" quality={80} class="author-photo" loading="lazy" />
          <div>
            <p class="author-name">Ahmed Ragab</p>
            <p class="author-line">Tech lead at VOIS. I build Android apps and the backends they talk to.</p>
            <a href="mailto:ahmedragab.se@gmail.com" class="btn btn-primary">Email me</a>
          </div>
        </aside>

        {isSeries ? (
          <SeriesNav series={series!} posts={seriesPosts} currentId={post.id} variant="pager" />
        ) : (
          <nav class="post-pager" aria-label="Previous and next posts">
            {older ? (
              <a href={`${base}blog/${older.id}`}>
                <span class="mono">← Previous post</span>
                <span class="post-pager-title">{older.data.title}</span>
              </a>
            ) : <span />}
            {newer && (
              <a href={`${base}blog/${newer.id}`} class="is-next">
                <span class="mono">Next post →</span>
                <span class="post-pager-title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )}

        <RelatedPosts currentSlug={post.id} currentTags={post.data.tags} currentSeries={isSeries ? series : undefined} />

        <p class="post-back"><a href={`${base}blog`} class="text-link"><span aria-hidden="true">←&nbsp;</span> All posts</a></p>
      </div>
    </div>
  </article>
  </main>

  <a href="#main-content" class="back-to-top" data-back-to-top aria-label="Back to top">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>

  <style is:global>
    .reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 100%;
      background: var(--color-ink);
      transform-origin: 0 50%;
      transform: scaleX(0);
      z-index: 100;
    }

    .post {
      padding-block: 32px 64px;
    }

    /* ---- Header ---- */
    .post-head {
      max-width: 900px;
      margin-bottom: 56px;
    }

    .post-meta-line {
      display: flex;
      flex-wrap: wrap;
      gap: 2px 10px;
      margin-bottom: 24px;
    }

    .post-head h1 {
      font-size: clamp(2.125rem, 6.5vw, 4.75rem);
      line-height: 1;
      text-wrap: balance;
    }

    .standfirst {
      max-width: 44rem;
      margin-top: 24px;
      font-size: clamp(1.125rem, 2vw, 1.375rem);
      line-height: 1.5;
      color: var(--color-body);
    }

    .post-level {
      margin-top: 20px;
    }

    /* ---- Layout: article with the "On this page" card beside it (above it on small screens) ---- */
    .post-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .post-body {
      min-width: 0;
      max-width: 720px;
    }

    @media (min-width: 1024px) {
      .post-layout {
        grid-template-columns: minmax(0, 720px) minmax(0, 320px);
        justify-content: space-between;
        gap: 64px;
      }

      .toc-card {
        grid-column: 2;
        grid-row: 1;
      }

      .post-body {
        grid-column: 1;
        grid-row: 1;
      }
    }

    /* Deliberately not sticky: it scrolls away with the top of the article. */
    .toc-card {
      align-self: start;
      max-width: 720px;
      padding: 24px;
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-card);
      background: var(--color-card);
    }

    .toc-card h2 {
      line-height: 1.5;
    }

    .toc-card ol {
      margin: 10px 0 0;
      padding: 0;
      list-style: none;
      counter-reset: toc;
    }

    .toc-card li {
      counter-increment: toc;
      border-top: 1px solid var(--color-hairline);
    }

    .toc-card li:first-child {
      border-top: 0;
    }

    .toc-card a {
      display: flex;
      align-items: baseline;
      gap: 12px;
      min-height: 44px;
      padding: 10px 0;
      font-size: 0.9375rem;
      line-height: 1.35;
      color: var(--color-ink);
      text-decoration: none;
    }

    .toc-card a::before {
      content: counter(toc, decimal-leading-zero);
      flex-shrink: 0;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-muted);
    }

    .toc-card a:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    /* ---- Prose ---- */
    .blog-content {
      color: var(--color-body);
      font-size: 1.125rem;
      line-height: 1.75;
    }

    .blog-content h1,
    .blog-content h2,
    .blog-content h3,
    .blog-content h4,
    .blog-content h5,
    .blog-content h6 {
      margin-top: 3rem;
      margin-bottom: 1rem;
      scroll-margin-top: 1.5rem;
      text-wrap: balance;
    }

    .blog-content h1 {
      font-size: clamp(2rem, 4vw, 2.5rem);
      line-height: 1.05;
    }

    .blog-content h2 {
      margin-top: 3.5rem;
      font-size: clamp(1.75rem, 3.6vw, 2.375rem);
      line-height: 1.05;
    }

    .blog-content h3 {
      font-size: clamp(1.375rem, 2.4vw, 1.625rem);
      line-height: 1.15;
    }

    .blog-content h4,
    .blog-content h5,
    .blog-content h6 {
      font-size: 1.125rem;
      font-weight: 600;
      line-height: 1.3;
    }

    .blog-content p {
      margin-bottom: 1.5rem;
    }

    .blog-content a {
      color: var(--color-ink);
      text-decoration: underline;
      text-decoration-thickness: 1.5px;
      text-underline-offset: 0.2em;
    }

    .blog-content a:hover {
      background: var(--color-lime);
    }

    .blog-content ul,
    .blog-content ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
    }

    .blog-content li {
      margin-bottom: 0.5rem;
    }

    .blog-content ul li { list-style-type: disc; }
    .blog-content ol li { list-style-type: decimal; }
    .blog-content li::marker { color: var(--color-muted); }

    .blog-content strong {
      font-weight: 600;
      color: var(--color-ink);
    }

    /* Inline code: a sunken pill. */
    .blog-content code {
      padding: 0.1em 0.5em;
      border-radius: 999px;
      background-color: var(--color-sunken);
      color: var(--color-ink);
      font-family: var(--font-mono);
      font-size: 0.85em;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    /* ---- Code blocks: the dark card with a header bar ---- */
    .code-block {
      margin: 2.25rem 0;
      border-radius: var(--radius-card);
      overflow: hidden;
      background-color: var(--color-dark);
    }

    .code-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 4px 8px 4px 22px;
      border-bottom: 1px solid var(--color-dark-rule);
      font-family: var(--font-mono);
    }

    .code-lang {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-dark-muted);
    }

    .code-copy-btn {
      min-width: 44px;
      min-height: 44px;
      padding: 0 14px;
      border: 1px solid var(--color-dark-rule);
      border-radius: 999px;
      background-color: transparent;
      color: var(--color-dark-secondary);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      cursor: pointer;
    }

    .code-copy-btn:hover {
      border-color: var(--color-dark-text);
      color: var(--color-dark-text);
    }

    .code-copy-btn.copied {
      border-color: var(--color-lime);
      background-color: var(--color-lime);
      color: var(--color-ink);
    }

    .code-copy-btn:focus-visible,
    .code-block pre:focus-visible {
      outline-color: var(--color-lime);
      outline-offset: -3px;
    }

    .blog-content pre {
      margin: 0;
      padding: 20px 22px 24px;
      overflow-x: auto;
      border-radius: 0;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      line-height: 1.65;
      tab-size: 2;
    }

    .blog-content pre code {
      padding: 0;
      border-radius: 0;
      background-color: transparent;
      color: inherit;
      font-size: inherit;
    }

    /* ---- Blockquotes: the lime "heads up" box ---- */
    .blog-content blockquote {
      margin: 2.25rem 0;
      padding: 22px 26px;
      border-radius: var(--radius-card);
      background: var(--color-lime);
      color: var(--color-ink);
    }

    .blog-content blockquote::before {
      content: 'Heads up';
      display: block;
      margin-bottom: 8px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .blog-content blockquote > :last-child {
      margin-bottom: 0;
    }

    /* On lime, mark links and code with ink rather than more lime or grey. */
    .blog-content blockquote a:hover,
    .callout a:hover {
      background: var(--color-ink);
      color: var(--color-lime);
    }

    .blog-content blockquote code,
    .callout code {
      background-color: rgb(18 18 18 / 0.1);
    }

    .blog-content img {
      margin: 2.25rem 0;
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-card);
    }

    .blog-content img[src$=".svg"] {
      width: 100%;
      height: auto;
      border: none;
      border-radius: 0;
    }

    .figure-link {
      display: block;
      margin: 2.25rem 0;
      cursor: zoom-in;
    }

    .figure-link img {
      margin: 0 !important;
    }

    .blog-content .figure-link,
    .blog-content .figure-link:hover {
      background: none;
      text-decoration: none;
    }

    .blog-content details {
      margin: 1rem 0;
      padding: 4px 20px;
      border: 1px solid var(--color-hairline);
      border-radius: 16px;
      background: var(--color-card);
    }

    .blog-content summary {
      min-height: 44px;
      padding-block: 9px;
      cursor: pointer;
      font-weight: 500;
      color: var(--color-ink);
    }

    .blog-content details[open] > summary {
      margin-bottom: 0.5rem;
    }

    .blog-content hr {
      height: 1rem;
      margin: 3.5rem 0;
      border: none;
      text-align: center;
    }

    .blog-content hr::before {
      content: '· · ·';
      padding-left: 1.2em;
      font-size: 0.875rem;
      letter-spacing: 1.2em;
      color: var(--color-muted);
    }

    .table-scroll {
      margin: 2.25rem 0;
      overflow-x: auto;
      border: 1px solid var(--color-hairline);
      border-radius: 16px;
      background: var(--color-card);
    }

    .blog-content table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    .blog-content td {
      min-width: 8rem;
    }

    .blog-content td:first-child {
      min-width: 6rem;
    }

    .blog-content th,
    .blog-content td {
      padding: 12px 18px;
      text-align: left;
      border-bottom: 1px solid var(--color-hairline);
    }

    .blog-content th {
      background-color: var(--color-sunken);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-ink);
    }

    .blog-content tbody tr:last-child td {
      border-bottom: none;
    }

    /* ---- Article end ---- */
    .article-actions {
      margin-top: 3.5rem;
      padding-top: 1.5rem;
      border-top: 2px solid var(--color-ink);
    }

    .article-share {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }

    .article-share .mono-caps {
      margin-right: 6px;
    }

    .share-btn {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 16px;
      border: 1px solid var(--color-hairline);
      border-radius: 999px;
      background: var(--color-card);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      color: var(--color-ink);
      text-decoration: none;
      cursor: pointer;
    }

    .share-btn:hover {
      border-color: var(--color-ink);
    }

    .author-card {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-top: 2rem;
      padding: 24px;
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-card);
      background: var(--color-card);
    }

    .author-photo {
      flex-shrink: 0;
      width: 88px;
      height: 110px;
      object-fit: cover;
      object-position: center 15%;
      border-radius: 16px;
    }

    .author-name {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
      color: var(--color-ink);
    }

    .author-line {
      margin-block: 6px 16px;
      font-size: 1rem;
    }

    .post-pager {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 2rem;
    }

    .post-pager a {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 18px 22px;
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-card);
      background: var(--color-card);
      color: var(--color-ink);
      text-decoration: none;
    }

    .post-pager a:hover {
      border-color: var(--color-ink);
    }

    .post-pager a.is-next {
      grid-column: 2;
      text-align: right;
    }

    .post-pager-title {
      font-weight: 500;
      line-height: 1.3;
      text-wrap: balance;
    }

    .post-back {
      margin-top: 2rem;
    }

    .back-to-top {
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      z-index: 40;
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1.5px solid var(--color-ink);
      border-radius: 999px;
      background: var(--color-card);
      color: var(--color-ink);
      opacity: 0;
      transform: translateY(0.5rem);
      pointer-events: none;
      transition: opacity 0.2s ease-out, transform 0.2s ease-out;
    }

    .back-to-top.is-visible {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .back-to-top:hover {
      background: var(--color-ink);
      color: var(--color-dark-text);
    }

    @media (max-width: 640px) {
      .blog-content { font-size: 1.0625rem; }

      .code-block,
      .blog-content blockquote {
        border-radius: 16px;
      }

      .blog-content pre {
        padding-inline: 16px;
        font-size: 0.8125rem;
      }

      .code-toolbar {
        padding-left: 16px;
      }

      .author-card {
        flex-direction: column;
        align-items: flex-start;
      }

      .post-pager {
        grid-template-columns: 1fr;
      }

      .post-pager a.is-next {
        grid-column: 1;
        order: -1;
        text-align: left;
      }

      .back-to-top {
        right: 1rem;
        bottom: 1rem;
      }

      /* Printing from a phone is rare; dropping it keeps the share row short. */
      .share-btn[data-print] {
        display: none;
      }
    }

    @media print {
      .site-header, .site-footer, .toc-card, .article-actions, .author-card, .post-pager,
      .series-end, .related, .post-back, .back-to-top, .reading-progress, .code-copy-btn { display: none !important; }
    }
  </style>

  <script>
    // Everything here is (re)initialised on every `astro:page-load` (first load and each
    // view-transition navigation) and torn down on `astro:before-swap`, so state never goes stale.
    const READ_KEY = 'read-posts';
    let teardown: (() => void) | undefined;

    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function announce(message: string) {
      const live = document.querySelector<HTMLElement>('[data-live-status]');
      if (!live) return;
      live.textContent = '';
      requestAnimationFrame(() => (live.textContent = message));
    }

    function readPosts(): string[] {
      try {
        const value = JSON.parse(localStorage.getItem(READ_KEY) ?? '[]');
        return Array.isArray(value) ? value : [];
      } catch {
        return [];
      }
    }

    function markRead(id: string) {
      try {
        const read = readPosts();
        if (!read.includes(id)) localStorage.setItem(READ_KEY, JSON.stringify([...read, id]));
      } catch {
        // Storage unavailable (private mode, blocked): read state is a convenience only.
      }
    }

    function addCodeToolbars() {
      // Mermaid blocks are replaced by rendered diagrams (see BaseLayout), so skip them.
      document.querySelectorAll<HTMLPreElement>('.blog-content pre:not([data-language="mermaid"])').forEach((pre) => {
        if (pre.parentElement?.classList.contains('code-block')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';

        const toolbar = document.createElement('div');
        toolbar.className = 'code-toolbar';

        const lang = document.createElement('span');
        lang.className = 'code-lang';
        lang.textContent = pre.dataset.language || 'code';
        // The card has rounded corners, so keyboard users need to be able to scroll long lines.
        pre.tabIndex = 0;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy-btn';
        btn.textContent = 'Copy';
        btn.setAttribute('aria-label', 'Copy code to clipboard');

        toolbar.append(lang, btn);
        pre.replaceWith(wrapper);
        wrapper.append(toolbar, pre);

        btn.addEventListener('click', async () => {
          const text = pre.querySelector('code')?.innerText ?? '';
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = 'Copied!';
            announce('Code copied to clipboard');
          } catch {
            btn.textContent = 'Copy failed';
            announce('Copy failed. Select the code and copy it manually.');
          }
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = 'Copy';
            btn.classList.remove('copied');
          }, 2000);
        });
      });
    }

    function enhanceContent() {
      // Tables scroll inside a wrapper on narrow screens instead of stretching the page.
      document.querySelectorAll<HTMLTableElement>('.blog-content table').forEach((table) => {
        if (table.parentElement?.classList.contains('table-scroll')) return;
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        wrap.tabIndex = 0;
        wrap.setAttribute('role', 'region');
        wrap.setAttribute('aria-label', 'Table, scrolls horizontally');
        table.replaceWith(wrap);
        wrap.append(table);
      });

      // Figures open full size, so their small text stays readable on phones.
      document.querySelectorAll<HTMLImageElement>('.blog-content img[src$=".svg"]').forEach((img) => {
        if (img.closest('a')) return;
        const link = document.createElement('a');
        link.href = img.getAttribute('src') ?? '';
        link.target = '_blank';
        link.rel = 'noopener';
        link.className = 'figure-link';
        link.setAttribute('aria-label', `Open figure full size: ${img.alt}`);
        img.replaceWith(link);
        link.append(img);
      });
    }

    function initArticle() {
      teardown?.();
      teardown = undefined;

      const article = document.querySelector<HTMLElement>('[data-article]');
      if (!article) return;

      addCodeToolbars();
      enhanceContent();

      const postId = article.dataset.article!;
      const controller = new AbortController();
      const { signal } = controller;

      const progress = document.querySelector<HTMLElement>('.reading-progress');
      const backToTop = document.querySelector<HTMLElement>('[data-back-to-top]');
      // Read state in the series outline.
      const read = readPosts();
      document.querySelectorAll<HTMLElement>('[data-series-outline] li[data-post-id]').forEach((li) => {
        const mark = li.querySelector<HTMLElement>('.series-read');
        if (mark) mark.hidden = !read.includes(li.dataset.postId!) || li.classList.contains('is-current');
      });
      let markedRead = read.includes(postId);

      let frame = 0;

      const update = () => {
        frame = 0;
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
        if (progress) progress.style.transform = `scaleX(${ratio})`;
        backToTop?.classList.toggle('is-visible', window.scrollY > window.innerHeight * 2);

        if (!markedRead && ratio > 0.6) {
          markRead(postId);
          markedRead = true;
        }
      };

      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      window.addEventListener('scroll', schedule, { passive: true, signal });
      window.addEventListener('resize', schedule, { passive: true, signal });
      update();

      backToTop?.addEventListener('click', (event) => {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
        document.getElementById('main-content')?.focus({ preventScroll: true });
      }, { signal });

      document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            btn.textContent = 'Copied!';
            announce('Link copied to clipboard');
          } catch {
            btn.textContent = 'Copy failed';
            announce('Copy failed. Copy the address from the browser bar.');
          }
          setTimeout(() => (btn.textContent = 'Copy link'), 2000);
        }, { signal });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((btn) => {
        btn.addEventListener('click', () => window.print(), { signal });
      });

      teardown = () => {
        controller.abort();
        if (frame) cancelAnimationFrame(frame);
      };
    }

    document.addEventListener('astro:page-load', initArticle);
    document.addEventListener('astro:before-swap', () => {
      teardown?.();
      teardown = undefined;
    });
  </script>
</BaseLayout>
