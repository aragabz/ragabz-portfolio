---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import BlogFilter from '../../components/react/BlogFilter';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const blogPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Serialize dates for React client component hydration compatibility
const serializedPosts = blogPosts.map(post => ({
  id: post.id,
  data: {
    title: post.data.title,
    excerpt: post.data.excerpt,
    date: post.data.date.toISOString(),
    readingTime: post.data.readingTime,
    tags: post.data.tags || [],
    draft: post.data.draft,
  }
}));
---

<BaseLayout 
  title="Blog - Thoughts on Development & Tech"
  description="Articles about software development, tech, and learning"
>
  <Navbar />

  <div class="min-h-screen py-12 px-6">
    <div class="max-w-container mx-auto">
      <!-- Header -->
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-3" style="color: var(--color-text);">
          Blog
        </h1>
        <p class="text-lg" style="color: var(--color-text-secondary);">
          Thoughts on software development, tech, and continuous learning
        </p>
      </header>

      <!-- Blog Posts Filter & Search Component -->
      <BlogFilter client:load posts={serializedPosts} base={base} />
    </div>
  </div>
</BaseLayout>
