---
import BaseLayout from '../layouts/BaseLayout.astro';

// Update this content monthly!
const lastUpdated = 'July 2026';

const currentProjects = [
  { title: 'Portfolio v3', status: 'In Progress', description: 'Redesigning portfolio with Astro 7' },
  { title: 'Open Source CLI Tool', status: 'Planning', description: 'Building a developer productivity tool' },
];

const learning = [
  { topic: 'Rust Programming', progress: 40, description: 'Systems programming language' },
  { topic: 'AWS Solutions Architect', progress: 65, description: 'Cloud architecture certification' },
  { topic: 'Design Patterns', progress: 80, description: 'Software architecture patterns' },
];

const reading = [
  { title: 'The Pragmatic Programmer', author: 'David Thomas & Andrew Hunt', status: 'Reading' },
  { title: 'Designing Data-Intensive Applications', author: 'Martin Kleppmann', status: 'Next Up' },
];

const interests = [
  'Building side projects',
  'Technical writing and blogging',
  'UI/UX design and animations',
  'Contributing to open source',
];
---

<BaseLayout
  title="Now - What I'm Doing"
  description="What I'm currently working on, learning, and interested in"
>
  <main id="main-content" tabindex="-1" class="wrap page">
    <div class="page-narrow">
      <p class="mono-caps">Last updated {lastUpdated}</p>
      <h1 class="page-title">Now</h1>
      <p class="page-intro">
        A snapshot of my current projects, learning goals and interests. Inspired by Derek Sivers'
        <a href="https://nownownow.com/about" class="inline-link" rel="noopener noreferrer">/now movement</a>.
      </p>

      <section class="page-section">
        <h2>Current projects</h2>
        <ul class="row-list">
          {currentProjects.map((project) => (
            <li>
              <p class="row-name">
                {project.title}
                <span class:list={['chip', { 'chip-lime': project.status === 'In Progress' }]}>{project.status.toLowerCase()}</span>
              </p>
              <p>{project.description}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="page-section">
        <h2>Learning</h2>
        <ul class="row-list">
          {learning.map((item) => (
            <li>
              <p class="row-name">{item.topic}</p>
              <div>
                <p>{item.description}</p>
                <div class="meter">
                  <progress max="100" value={item.progress} aria-label={`${item.topic} progress`}>{item.progress}%</progress>
                  <span class="mono">{item.progress}%</span>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="page-section">
        <h2>Reading</h2>
        <ul class="row-list">
          {reading.map((book) => (
            <li>
              <p class="row-name">
                {book.title}
                <span class:list={['chip', { 'chip-lime': book.status === 'Reading' }]}>{book.status.toLowerCase()}</span>
              </p>
              <p>by {book.author}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="page-section">
        <h2>Interests</h2>
        <ul class="row-list interests">
          {interests.map((interest) => <li>{interest}</li>)}
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .page-title {
    margin-top: 16px;
  }

  .inline-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .row-name .chip {
    margin-left: 10px;
    vertical-align: 2px;
  }

  .meter {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
  }

  progress {
    flex: 1;
    height: 8px;
    border: 0;
    border-radius: 999px;
    background: var(--color-sunken);
    overflow: hidden;
    appearance: none;
  }

  progress::-webkit-progress-bar {
    background: var(--color-sunken);
  }

  progress::-webkit-progress-value {
    background: var(--color-ink);
  }

  progress::-moz-progress-bar {
    background: var(--color-ink);
  }

  .interests > li {
    display: block;
    color: var(--color-ink);
  }
</style>
