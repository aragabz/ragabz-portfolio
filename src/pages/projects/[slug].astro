---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, tech, github, live, image, category, year, status, overview, features } = project.data;

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allProjects.findIndex((p) => p.id === project.id);
const prev = allProjects[(currentIndex - 1 + allProjects.length) % allProjects.length];
const next = allProjects[(currentIndex + 1) % allProjects.length];
const hasOthers = allProjects.length > 1;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const withBase = (path: string) => (path.startsWith('/') ? `${base}${path.slice(1)}` : path);
const isNpm = (url: string) => /npmjs\.com/.test(url);
---

<BaseLayout title={`${title} - Project`} description={description}>
  <main id="main-content" tabindex="-1" data-pagefind-body class="wrap page">
    <div class="page-narrow">
      <a href={`${base}#projects`} class="text-link"><span aria-hidden="true">←&nbsp;</span> All projects</a>

      <header class="project-head">
        <p class="mono project-meta">
          <span>{category}{year && ` · ${year}`}</span>
          {status && <span class="chip chip-lime">{status.toLowerCase()}</span>}
        </p>
        <h1 class="page-title" data-pagefind-meta="title">{title}</h1>
        <p class="page-intro">{description}</p>

        <div class="project-actions">
          {github && <a href={github} class="btn btn-primary" rel="noopener noreferrer">View on GitHub</a>}
          {live && (
            <a href={live} class:list={['btn', github ? 'btn-outline' : 'btn-primary']} rel="noopener noreferrer">
              {isNpm(live) ? 'View on npm' : 'View live'}
            </a>
          )}
        </div>
      </header>

      <img src={withBase(image)} alt="" class="project-cover" fetchpriority="high" />

      {overview && (
        <section class="page-section">
          <h2>Overview</h2>
          <p class="project-overview">{overview}</p>
        </section>
      )}

      {features && features.length > 0 && (
        <section class="page-section">
          <h2>What's in it</h2>
          <ul class="row-list feature-list">
            {features.map((feature) => <li>{feature}</li>)}
          </ul>
        </section>
      )}

      <section class="page-section">
        <h2>Stack</h2>
        <p class="project-stack">{tech.join(' · ')}</p>
      </section>

      {hasOthers && (
        <nav class="project-pager" aria-label="Other projects">
          <a href={`${base}projects/${prev.id}`}>
            <span class="mono">← Previous project</span>
            <span class="project-pager-title">{prev.data.title}</span>
          </a>
          <a href={`${base}projects/${next.id}`} class="is-next">
            <span class="mono">Next project →</span>
            <span class="project-pager-title">{next.data.title}</span>
          </a>
        </nav>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .project-head {
    margin-block: 24px 40px;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-bottom: 18px;
  }

  .page-title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .project-cover {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
  }

  .project-overview {
    margin-top: 20px;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .feature-list > li {
    display: block;
    color: var(--color-ink);
  }

  .project-stack {
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .project-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
  }

  .project-pager a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 22px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-card);
    color: var(--color-ink);
    text-decoration: none;
  }

  .project-pager a:hover {
    border-color: var(--color-ink);
  }

  .project-pager .is-next {
    text-align: right;
  }

  .project-pager-title {
    font-weight: 500;
    line-height: 1.3;
  }

  @media (max-width: 560px) {
    .project-pager {
      grid-template-columns: 1fr;
    }

    .project-pager .is-next {
      text-align: left;
    }
  }
</style>
